APP_DEBUG = true

# ---- EIP 库（只读：用户 / 角色 / 权限）----
EIP_DB_HOST = 127.0.0.1
EIP_DB_NAME = INUEIP
EIP_DB_USER = root
EIP_DB_PASS =
EIP_DB_PORT = 3306
EIP_DB_PREFIX = inue_

# ---- 知识库库（读写：kb_* 业务表）----
KB_DB_HOST = 127.0.0.1
KB_DB_NAME = Inuwiki
KB_DB_USER = root
KB_DB_PASS =
KB_DB_PORT = 3306
KB_DB_PREFIX =

DEFAULT_LANG = zh-cn

# 队列连接：生产用 redis；本地无 Redis 时设 sync（同步执行，仅用于跑通链路）
QUEUE_CONNECTION = redis

# 知识库独立 JWT 密钥，生产环境务必更换为随机 64 位字符串，且不要提交到版本库
JWT_SECRET = change-me-to-a-random-64-char-string
